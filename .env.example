# Copy to .env and fill in. Never commit .env.

# --- Data -------------------------------------------------------------------
# Hugging Face token with access to foursquare/fsq-os-places (accept the dataset
# terms on huggingface.co first). With it, scripts/prepare_sydney.py downloads
# real Sydney POIs; without it, it generates synthetic demo data.
HF_TOKEN=

# --- App --------------------------------------------------------------------
# development | production. Production turns on secure cookies, HSTS, hides
# API docs and serves frontend/dist from the API process.
APP_ENV=development
# Where accounts, brands and shortlists live:
#   sqlite    - data/app_v2.db, for local development (one machine only)
#   firestore - Google Cloud Firestore, shared by every server instance (production)
STORAGE=sqlite
# Firestore project (with STORAGE=firestore). On Cloud Run the service account is used, no key file.
# GOOGLE_CLOUD_PROJECT=
# Signs session cookies. Required in production (long random string, keep it in Secret Manager).
# In development one is generated into data/.secret_key.
# SECRET_KEY=
# Trust X-Forwarded-For for the client IP (on by default in production behind Cloud Run)
# TRUST_PROXY=true
# Comma-separated origins allowed to call the API with cookies
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# COOKIE_SECURE=true        # forced on in production
# SESSION_DAYS=7

# --- Assistant --------------------------------------------------------------
# Groq (free tier) powers the chat assistant. Without a key it falls back to
# built-in keyword rules. Get a key at console.groq.com.
GROQ_API_KEY=
# Optional: force a model; by default the first available of a preferred list
# (currently openai/gpt-oss-120b) is used.
# GROQ_MODEL=

